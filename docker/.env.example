# =============================================================================
# Local mode (same WiFi network as robot) — used by docker-compose.mac.yml
# =============================================================================
ROBOT_IP=<the robot's address on your LAN, e.g. 192.168.1.42 — `make find-robot`>
CONN_TYPE=webrtc
WEBRTC_SERVER_PORT=9991
AES_128_KEY=<32 hex chars — see "Get the AES-128 key" in DEVELOPER_GUIDE.md>
# Which LAN flavour: sta (default) = robot and Mac share a network, uses
# ROBOT_IP above. ap = the Mac's WiFi is joined to the robot's OWN hotspot; the
# robot is at a fixed 192.168.12.1 and ROBOT_IP is ignored.
#
# AP mode is the only connection path that never calls Unitree's cloud (no
# login, no token, no TURN), so it can't be blocked by the EdgeOne WAF. The
# trade: that WiFi interface has no internet, so dual-home the Mac (ethernet /
# USB-C / iPhone tethering) or anything Bedrock-backed will fail. Cloud stacks
# can't use AP mode at all — nothing can route into the robot's hotspot.
# Test the handshake standalone first: scripts/ap_mode_lichtblick.py
# LOCAL_MODE=ap

# =============================================================================
# Remote mode (Unitree TURN server) — for driving the dog from THIS Mac without
# sharing its network. Set CONN_TYPE=remote and fill in the Unitree account
# details; ROBOT_IP and AES_128_KEY are not needed.
#
# The CLOUD deployment does not read this file. Go2Ec2Stack pulls email,
# password, and serial from one Secrets Manager secret at container start — see
# AWS_DEPLOYMENT.md.
# =============================================================================
# CONN_TYPE=remote
# UNITREE_EMAIL=<your Unitree account email>
# UNITREE_SERIAL=<robot serial number, e.g. B42A12345678>
# Provide exactly one password source:
#   UNITREE_PASSWORD=<plaintext — dev/testing only>
#   UNITREE_SECRET_NAME=<AWS Secrets Manager secret name — prod>
#     Secret JSON format: {"<email>": "<password>"}  OR  {"password": "<password>"}

# =============================================================================
# Bedrock vision region (optional — leave unset to use the code default).
# SCENE_REGION is where the cross-region inference profile resolves, not where
# the container runs.
# =============================================================================
# SCENE_REGION=us-west-2

# =============================================================================
# COCO object detector backbone (local torchvision model, not Bedrock):
# fast | balanced | accurate | best — accuracy ascending, speed descending.
# =============================================================================
# COCO_MODEL=balanced
# COCO_THRESHOLD=0.5

# =============================================================================
# KVS streaming (set KVS_ENABLED=true to stream camera to AWS KVS)
# =============================================================================
KVS_ENABLED=false
KVS_STREAM_NAME=go2-robot-01-camera
AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# AWS credentials — deliberately NOT set here.
# =============================================================================
# There are no AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY lines in this file on
# purpose. This file is a checked-in template that people copy to .env and edit,
# which is exactly the wrong place for a long-lived credential to end up.
#
# The container gets credentials one of three ways instead, all of them without a
# key in a file:
#
#   1. In the cloud (Go2Ec2Stack) — the instance profile (RobotRole). Nothing to
#      configure and nothing to rotate. This is the pattern to copy.
#   2. Locally with SSO — docker-compose inherits AWS_* from YOUR SHELL, so:
#        aws sso login --profile <your-profile>
#        eval "$(aws configure export-credentials --profile <your-profile> \
#                 --format env)"
#        make up
#      The credentials are short-lived and never touch disk.
#   3. Locally with a profile file — uncomment the ~/.aws mount and AWS_PROFILE
#      passthrough in docker/docker-compose.mac.yml, then set AWS_PROFILE in your
#      shell. The container reads your existing config read-only.
#
# If you have no choice but static keys, export them in your shell for the one
# session. Do not add them to this file or to .env.
