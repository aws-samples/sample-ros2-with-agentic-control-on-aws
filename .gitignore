# colcon build output
build
log
install

# A local ros2_ws is never part of this repo: the container builds into its own
# /ros2_ws, and a host-side one is only ever a stray clone.
ros2_ws/

# Host-side venvs. One glob covers .venv and any experiment beside it — keep it
# a glob so a stray venv is never committed or shipped into a Docker context.
.venv*/

__pycache__
.env
.DS_Store

go2_robot_sdk/.coverage
go2_robot_sdk/coverage.xml

docker/logs/
docker/go2_accessKeys.csv

# Raw LIDAR pointcloud dumps — MAP_SAVE=True writes <MAP_NAME>.ply to the repo
# root every 10s (see DEVELOPER_GUIDE "3D raw pointcloud dump"). Debug output.
*.ply

# SLAM map artifacts (regenerated by mapping.launch.py)
maps/

# deployment/ is the repo's only npm/TypeScript project. tsconfig sets
# outDir: ./dist, so compiled .js/.d.ts land in dist/ — there is nothing to
# ignore beside the .ts sources.
deployment/node_modules/

# pnpm-lock.yaml is the ONE lockfile for deployment/ (see the //pinning note in
# deployment/package.json). npm builds its lockfile BEFORE running scripts, so the
# preinstall guard there rejects the install but cannot stop the file appearing —
# this makes sure a stray one can never be committed and drift again.
deployment/package-lock.json
deployment/dist/
deployment/cdk.out/
deployment/cdk.context.json

*.bkp
CLAUDE.md
.claude/settings.json
.claude/settings.local.json

.vscode/*
!.vscode/tasks.json
.ash

# MuJoCo writes this to the working directory on GL/render errors (simulation
# transport, see voice_agent/sim_dog.py). Diagnostic output, never source.
MUJOCO_LOG.TXT

# Frames written by `make sim-demo SAVE=1` (voice_agent/main_sim.py --save-frames).
sim_frames/

# docs/ is a local scratch area (drafts, diagram sources). Only the exported
# PNGs that the READMEs link to are tracked.
docs/*
!docs/*.png
